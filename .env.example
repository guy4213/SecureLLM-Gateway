# Server
PORT=3000
NODE_ENV=development

# Database (Docker service names — use localhost:... for local dev outside Docker)
MONGO_URI=mongodb://mongo:27017/securellm
REDIS_URI=redis://redis:6379

# OpenAI API key (sk-...)
# If missing: server starts, /v1/chat returns 503, /healthz reports missing_key
OPENAI_API_KEY=

# AES-256-GCM key for encrypting PII maps at rest in audit log
# Generate: openssl rand -hex 32
PII_ENC_KEY=

# Rate Limiting (defaults: 30 req / 60s window per API key)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Hard timeout for upstream OpenAI calls (ms). 1000–120000.
LLM_REQUEST_TIMEOUT_MS=30000

# Per-tenant response cache TTL in seconds. Set to 0 to disable.
LLM_CACHE_TTL_SECONDS=300
MAX_TOKENS_CAP=2048